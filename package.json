{
  "name": "charlier",
  "displayName": "Charlier: Antigravity Account Switcher",
  "description": "Instant, zero-dependency account switcher and profile vault for Google Antigravity.",
  "version": "0.1.0",
  "publisher": "Sernine",
  "repository": {
    "type": "git",
    "url": "https://github.com/prince-sernine/charlier"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "keywords": [
    "antigravity",
    "account switcher",
    "gemini",
    "google",
    "quota"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "charlier.switchProfile",
        "title": "Charlier: Switch Profile",
        "category": "Charlier"
      },
      {
        "command": "charlier.viewQuota",
        "title": "Charlier: View Quota & Model Limits",
        "category": "Charlier"
      },
      {
        "command": "charlier.refreshQuota",
        "title": "Charlier: Refresh Limits",
        "category": "Charlier"
      },
      {
        "command": "charlier.renameProfile",
        "title": "Charlier: Rename Profile",
        "category": "Charlier"
      },
      {
        "command": "charlier.saveProfile",
        "title": "Charlier: Save Current Profile",
        "category": "Charlier"
      },
      {
        "command": "charlier.addAccount",
        "title": "Charlier: Add New Account",
        "category": "Charlier"
      },
      {
        "command": "charlier.deleteProfile",
        "title": "Charlier: Delete Profile",
        "category": "Charlier"
      },
      {
        "command": "charlier.openVault",
        "title": "Charlier: Open Profiles Directory",
        "category": "Charlier"
      },
      {
        "command": "charlier.reloadWindow",
        "title": "Charlier: Reload Window",
        "category": "Charlier"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.config.mjs",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.0"
  }
}

